# ── AeroMind Tactical Defense AI Environment Template ───────────

# ── LangSmith Tracing ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=aeromind-defense-intel
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# ── Ollama Local SLM / VLM Configuration ───────────────────────
USE_OLLAMA=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
N_CTX=8192

# ── Multi-Agent SLM Capability Registry ────────────────────────
ENABLE_MULTI_AGENT=true
ORCHESTRATOR_MODEL=gemma3:4b
MATH_MODEL=gemma3:4b
VISION_MODEL=gemma3:4b
REASONING_MODEL=gemma3:4b
VERIFICATION_MODEL=gemma3:4b
SYNTHESIS_MODEL=gemma3:4b

# ── ColPali & Multimodal Visual Document RAG ───────────────────
ENABLE_VISUAL_RAG=true
PAGE_DPI=150
MAX_VISUAL_PAGES=3

# ── HuggingFace & Local Weights (Fallback) ──────────────────────
HF_MODEL_ID=./models
HF_TOKEN=

# ── Generation Parameters ──────────────────────────────────────
MAX_NEW_TOKENS=1200
TEMPERATURE=0.1
TOP_P=0.9
