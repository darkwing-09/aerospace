# ── Copy this to .env and fill in your values ──────────────────

# Your HuggingFace token (required to download varundevmishra09/My_Model)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace model repo ID
HF_MODEL_ID=varundevmishra09/My_Model

# ── llama.cpp GGUF mode (optional) ────────────────────────────
# Set to true if you have a GGUF file instead of using transformers
USE_LLAMA_CPP=false
GGUF_PATH=/home/yourname/model.gguf

# Number of GPU layers to offload (0 = CPU only, 35 = full GPU for 7B)
GPU_LAYERS=0

# ── Context window ─────────────────────────────────────────────
N_CTX=4096

# ── Generation parameters ──────────────────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1
TOP_P=0.9
