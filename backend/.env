# ── Copy this to .env and fill in your values ──────────────────

# Model directory path (points to downloaded weights)
HF_MODEL_ID=./models
HF_TOKEN=

# ── llama.cpp GGUF mode (optional) ────────────────────────────
# Set to true if you have a GGUF file instead of using transformers
USE_LLAMA_CPP=true
GGUF_PATH=/home/darkwing/my_model_q4.gguf

# Number of GPU layers to offload (0 = CPU only, 35 = full GPU for 7B)
GPU_LAYERS=0

# ── Context window ─────────────────────────────────────────────
N_CTX=4096

# ── Generation parameters ──────────────────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1
TOP_P=0.9
