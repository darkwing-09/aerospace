# ── AeroMind Tactical Defense AI Configuration ───────────────────

# ── LangSmith Tracing & Observability ──────────────────────────
# Set your LangSmith API key below to enable full cloud tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aeromind-defense-intel
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# ── Ollama Local SLM / VLM Configuration ───────────────────────
USE_OLLAMA=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
N_CTX=8192

# ── Multi-Agent SLM Capability Registry ────────────────────────
ENABLE_MULTI_AGENT=true
ORCHESTRATOR_MODEL=qwen2.5:7b-instruct
MATH_MODEL=qwen2.5-math:7b
VISION_MODEL=gemma4:e4b
REASONING_MODEL=deepseek-r1-distill-qwen:7b
VERIFICATION_MODEL=qwen2.5:3b-instruct
SYNTHESIS_MODEL=qwen2.5:3b

# ── ColPali & Multimodal Visual Document RAG ───────────────────
ENABLE_VISUAL_RAG=true
PAGE_DPI=150
MAX_VISUAL_PAGES=3

# ── HuggingFace & Local Weights (Fallback) ──────────────────────
HF_MODEL_ID=./models
HF_TOKEN=

# ── Generation Parameters ──────────────────────────────────────
MAX_NEW_TOKENS=1200
TEMPERATURE=0.1
TOP_P=0.9
