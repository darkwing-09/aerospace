# AeroMind 2.0 Zero-Egress Environment Configuration (PLAN §14.2)
# Strictly local execution with loopback-only communication.

ZERO_EGRESS_MODE=true
AEROMIND_ENV=local
AEROMIND_HW_TIER=cpu_lite

# Hugging Face & Transformers Offline Enforcements
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ENABLE_COLPALI_DOWNLOAD=false

# Ollama local endpoint
OLLAMA_HOST=127.0.0.1:11434

# Qdrant local storage
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
